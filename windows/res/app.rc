 * app.rc - the Windows app's icon, menu and dialogs (MS Shell Dlg: MS
 *          Sans Serif on Windows 9x, Tahoma or Segoe UI later)
 */
#include <windows.h>
#include "../src/resource.h"

IDI_APP ICON "dmodem.ico"

/* visual styles from Windows XP on (Windows 9x ignores it) */
1 24 "app.manifest"

IDR_MENU MENU
BEGIN
    POPUP "&Modem"
    BEGIN
        MENUITEM "&Start or Stop", IDM_START
        MENUITEM "&Line Settings...", IDM_LINE
        MENUITEM SEPARATOR
        MENUITEM "E&xit", IDM_EXIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About D-Modem", IDM_ABOUT
    END
END

IDD_LINE DIALOG 0, 0, 300, 286
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Line Settings"
FONT 8, "MS Shell Dlg"
BEGIN
    AUTORADIOBUTTON "Start &dmodemd on this computer (Windows 7 or later)", IDC_L_DMODEMD, 8, 8, 284, 10, WS_GROUP | WS_TABSTOP
    LTEXT           "SIP &user:", -1, 20, 24, 60, 8
    EDITTEXT        IDC_L_USER, 84, 22, 120, 12, ES_AUTOHSCROLL
    LTEXT           "&Password:", -1, 20, 40, 60, 8
    EDITTEXT        IDC_L_PASSWORD, 84, 38, 120, 12, ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT           "Ser&ver:", -1, 20, 56, 60, 8
    EDITTEXT        IDC_L_SERVER, 84, 54, 208, 12, ES_AUTOHSCROLL
    AUTOCHECKBOX    "Take &calls (register with the server)", IDC_L_LISTEN, 20, 72, 200, 10, WS_TABSTOP
    AUTOCHECKBOX    "Fax over &T.38", IDC_L_T38, 20, 84, 120, 10, WS_TABSTOP
    AUTOCHECKBOX    "Mark calls as modem data (V.15&2)", IDC_L_V152, 140, 84, 152, 10, WS_TABSTOP
    AUTOCHECKBOX    "Modem relay (V.15&0.1)", IDC_L_V150, 20, 96, 120, 10, WS_TABSTOP
    LTEXT           "C&ountry:", -1, 20, 112, 60, 8
    EDITTEXT        IDC_L_COUNTRY, 84, 110, 80, 12, ES_AUTOHSCROLL
    LTEXT           "(empty for the USA)", -1, 170, 112, 120, 8
    LTEXT           "USB &modem:", -1, 20, 128, 60, 8
    EDITTEXT        IDC_L_USB, 84, 126, 80, 12, ES_AUTOHSCROLL
    LTEXT           "(auto, or empty for SIP)", -1, 170, 128, 120, 8
    LTEXT           "dmodemd.e&xe:", -1, 20, 144, 60, 8
    EDITTEXT        IDC_L_PATH, 84, 142, 152, 12, ES_AUTOHSCROLL
    PUSHBUTTON      "&Browse...", IDC_L_BROWSE, 240, 141, 52, 14
    AUTORADIOBUTTON "dmodemd on &another computer, or as a service (TCP)", IDC_L_TCP, 8, 164, 284, 10, WS_TABSTOP
    LTEXT           "&Address:", -1, 20, 180, 60, 8
    EDITTEXT        IDC_L_ADDRESS, 84, 178, 120, 12, ES_AUTOHSCROLL
    AUTORADIOBUTTON "A modem on a &serial port", IDC_L_COM, 8, 198, 284, 10, WS_TABSTOP
    LTEXT           "P&ort:", -1, 20, 214, 60, 8
    COMBOBOX        IDC_L_PORT, 84, 212, 80, 120, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Commands when the modem &opens:", -1, 8, 236, 140, 8
    EDITTEXT        IDC_L_INIT, 8, 246, 284, 12, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 186, 266, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 242, 266, 50, 14
END

IDD_SETTING DIALOG 0, 0, 240, 110
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Change Setting"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "", IDC_S_LABEL, 8, 8, 224, 8
    LTEXT           "", IDC_S_HELP, 8, 20, 224, 20
    COMBOBOX        IDC_S_LIST, 8, 44, 224, 140, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_S_EDIT, 8, 44, 224, 12, ES_AUTOHSCROLL
    LTEXT           "", IDC_S_RANGE, 8, 62, 224, 8
    LTEXT           "", IDC_S_DEFAULT, 8, 74, 224, 8
    DEFPUSHBUTTON   "OK", IDOK, 126, 90, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 182, 90, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS 0x4
 FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "D-Modem\0"
            VALUE "FileDescription", "D-Modem\0"
            VALUE "FileVersion", "1.0.0\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 D-Modem Authors. AGPL-3.0-only.\0"
            VALUE "ProductName", "D-Modem\0"
            VALUE "ProductVersion", "1.0.0\0"
            VALUE "OriginalFilename", "dmodem.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
